(let 
  (
  (
    concat
    (lambda (a b) (sequence 
      (cond
        (= a nil) b
        else (cons (car a) (concat (cdr a) b))
      )
    ))
  )
  (interleave
    (lambda (to-interleave remaining result) 
      (cond
        (= remaining nil) result
        else (interleave
          to-interleave
          (cdr remaining)
          (cond 
            (= (cdr remaining) nil) (concat result (list (car remaining)))
            else (concat result (list (car remaining) to-interleave))
          )
        )
      )
    )
  )
  )

  (print (
    interleave 5 (list 1 2 3) (list)) ; 1 5 2 5 3
  )
)